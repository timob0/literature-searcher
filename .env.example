ZOTERO_API_URL=http://localhost:23119/api/
ZOTERO_STORAGE_DIR=~/Zotero/storage
ZOTERO_COLLECTION_FILE=data/zotero_collections.txt
ZOTERO_WORKERS=8
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=literature_chunks
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
# Optional: pin PyTorch's CPU thread pool (OMP/MKL_NUM_THREADS). Leave unset to use torch's default.
TORCH_NUM_THREADS=
CHUNK_TARGET_TOKENS=500
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=50
DISPLAY_TOP_PAPERS=15
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MANIFEST_PATH=data/index_manifest.sqlite
PASSAGE_STORE_PATH=data/passage_store.sqlite
BETTER_BIBTEX_ENABLED=true

# Active LLM provider: ollama | openai | openai_compatible | copilot
LLM_ENABLED=true
LLM_PROVIDER=ollama

# Local or trusted-LAN Ollama endpoint. Only selected evidence is sent there.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TEMPERATURE=0
OLLAMA_THINKING=false
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_OUTPUT_TOKENS=1024

# OpenAI cloud provider. Requires an API key; only selected evidence is sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=4000

# Generic OpenAI-compatible endpoint, local or remote.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
OPENAI_COMPATIBLE_NATIVE_STRUCTURED_OUTPUT=false

# GitHub Copilot CLI. The CLI owns authentication; no token is stored here.
COPILOT_CLI_EXECUTABLE=copilot
COPILOT_MODEL=
COPILOT_TIMEOUT_SECONDS=180

DEFINE_LLM_ENABLED=true
EXAMPLES_LLM_ENABLED=true
PAPER_SUMMARY_LLM_ENABLED=true
